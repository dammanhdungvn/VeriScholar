# VeriScholar Enterprise Environment Configuration Example
APP_ENV=production
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DB=verischolar
POSTGRES_USER=verischolar
POSTGRES_PASSWORD=verischolar_secure_pass
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long_for_security
REDIS_URL=redis://redis:6379/0
STORAGE_LOCAL_ROOT=/var/lib/verischolar/storage
