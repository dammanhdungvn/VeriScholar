# ==============================================================================
# VeriScholar Infrastructure Environment Configuration
# ==============================================================================

# PostgreSQL & pgvector Credentials
POSTGRES_USER=verischolar
POSTGRES_PASSWORD=verischolar
POSTGRES_DB=verischolar
POSTGRES_PORT=5432

# Container Naming:
# - Development: verischolar-postgres-dev
# - Staging:     postgres-staging
# - Production:  postgres-prod
POSTGRES_CONTAINER_NAME=verischolar-postgres-dev

# Application Database Connection URI
# Local Host URI:
DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar
# Container-to-Container URI (internal docker network):
# DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@postgres:5432/verischolar

# Local LLM Inference via Docker Model Runner (Port 12434)
DMR_BASE_URL=http://localhost:12434/engines/llama.cpp/v1
DMR_MODEL=ai/smollm2
