# ==============================================================================
# VeriScholar Infrastructure Environment Configuration (Docker Compose)
# ==============================================================================

# PostgreSQL 18 & pgvector Credentials (docker-compose.yml)
POSTGRES_USER=verischolar
POSTGRES_PASSWORD=verischolar
POSTGRES_DB=verischolar
POSTGRES_PORT=5432

# Container Naming:
# - Development: verischolar-postgres-dev
# - Staging:     postgres-staging
# - Production:  postgres-prod
POSTGRES_CONTAINER_NAME=verischolar-postgres-dev

# Redis 7 Cache & Task Broker
REDIS_PORT=6379

# ==============================================================================
# VeriScholar Frontend Client Configuration (apps/web)
# ==============================================================================

# Backend FastAPI base URL
VITE_API_BASE_URL=http://localhost:8000

# Backend API v1 prefix
VITE_API_PREFIX=/api/v1

# Browser window title
VITE_APP_TITLE="VeriScholar — Nền tảng AI Nghiên cứu & Soạn thảo Khoa học"

# Fallback interactive mock demo when Backend is not connected
VITE_ENABLE_MOCK_DEMO=true

# Maximum PDF upload size in bytes (50MB)
VITE_MAX_UPLOAD_SIZE_BYTES=52428800

# ==============================================================================
# VeriScholar Backend API & LLM Configuration (apps/api)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar
JWT_SECRET_KEY=verischolar-dev-secret-key-min-32-bytes-long-change-in-prod
ENABLE_DEV_AUTH_BYPASS=true

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud LLM Credentials (Optional, defaults to local Docker Model Runner)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=

# Langfuse PromptOps & LLM Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
