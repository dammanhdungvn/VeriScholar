# ==============================================================================
# VeriScholar Infrastructure Environment Configuration (Docker Compose)
# ==============================================================================

# PostgreSQL 18 & pgvector Credentials
POSTGRES_USER=verischolar
POSTGRES_PASSWORD=verischolar
POSTGRES_DB=verischolar
POSTGRES_PORT=5432

# Container Naming:
# - Development: verischolar-postgres-dev
# - Staging:     postgres-staging
# - Production:  postgres-prod
POSTGRES_CONTAINER_NAME=verischolar-postgres-dev

# Redis 7 Cache & Task Broker
REDIS_PORT=6379

# ==============================================================================
# AI Models & External Cloud Services Configuration
# ==============================================================================

# OpenAI API: Vector Embedding (text-embedding-3-small, 1536-dim) & LLM
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API: Cross-Encoder Reranker (rerank-v3.5)
COHERE_API_KEY=your_cohere_api_key_here

# Azure Document Intelligence: Scanned PDF OCR Fallback (Layout model)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here
