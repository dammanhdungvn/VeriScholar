# ==============================================================================
# VeriScholar Monorepo Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and apps/api/.env, then populate your credentials.
# NEVER commit .env or paste live secrets into source control or chat.

# ------------------------------------------------------------------------------
# 1. Infrastructure & Databases (Docker Compose: PostgreSQL 18 + pgvector + Redis)
# ------------------------------------------------------------------------------
POSTGRES_USER=verischolar
POSTGRES_PASSWORD=verischolar
POSTGRES_DB=verischolar
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=verischolar-postgres-dev

REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar
# TEST_DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar_test

# ------------------------------------------------------------------------------
# 2. Backend FastAPI Application & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
SQL_ECHO=false

# Authentication & JWT Security (Generate a strong random secret in production)
JWT_SECRET_KEY=verischolar-super-secure-jwt-secret-key-2026-production-grade
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ------------------------------------------------------------------------------
# 3. AI Observability & Tracing (Langfuse)
# ------------------------------------------------------------------------------
# Public & Secret keys from your Langfuse project (Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_MASK_INPUT_OUTPUT=false
LANGFUSE_ENVIRONMENT=verischolar-dev

# ------------------------------------------------------------------------------
# 4. LLM & Embedding Providers (API Keys)
# ------------------------------------------------------------------------------
# Provider switch: "docker-model-runner" | "openai" | "gemini" | "ollama"
LLM_PROVIDER=docker-model-runner

# Local Docker Model Runner (No API key needed)
DMR_BASE_URL=http://localhost:12434/engines/llama.cpp/v1
DMR_MODEL=ai/smollm2

# OpenAI API Key (Required if LLM_PROVIDER=openai or for evaluation runs)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cohere API Key (Optional: for advanced neural reranking)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_RELEVANCE_THRESHOLD=0.35

# Azure Document Intelligence (Optional: for high-fidelity OCR)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ------------------------------------------------------------------------------
# 5. SMTP Mail Server Configuration (Email OTP & Account Verification)
# ------------------------------------------------------------------------------
# Khi SMTP_HOST / SMTP_USER chưa được cấu hình, EmailService tự động fallback
# ghi mã OTP & nội dung email vào: storage/logs/auth-emails.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@verischolar.org
SMTP_FROM_NAME="VeriScholar Academic Platform"
APP_PUBLIC_URL=https://verischolar.duckdns.org

# ------------------------------------------------------------------------------
# 6. Resend API Email Service (Official transactional email delivery)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 7. OAuth 2.0 Identity Services (Sign-In with Google & GitHub)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. Frontend Client Configuration (apps/web)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=""
VITE_API_PREFIX=/api/v1
VITE_APP_TITLE="VeriScholar — Nền tảng AI Nghiên cứu & Soạn thảo Khoa học"
VITE_MAX_UPLOAD_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 9. E2B
# ------------------------------------------------------------------------------

E2B_API_KEY=
E2B_SECRET_LABEL=verischolar
E2B_SECRET_VALUE=
E2B_SECRET_ID=
E2B_WEBHOOKS=