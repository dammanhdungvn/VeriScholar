# Server Environment (development | production | test)
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Logging Configuration (console | json)
LOG_LEVEL=INFO
LOG_FORMAT=console

# SQL Engine Query Logging (false to prevent terminal flooding; true for verbose ORM query inspection)
SQL_ECHO=false

# Database Connection (PostgreSQL 18 + pgvector 0.8.6)
DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar

# Isolated Test Database (optional, for hermetic pytest & eval runs)
# TEST_DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar_test

# AI Provider Selection (Factory Switches)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
RERANK_PROVIDER=cohere

# OpenAI Configuration (LLM & Embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Cohere Configuration (Reranker)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_RELEVANCE_THRESHOLD=0.35

# dịch vụ Document Intelligence.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=


LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"


E2B_API_KEY=
E2B_SECRET_LABEL=verischolar
E2B_SECRET_VALUE=
E2B_SECRET_ID=
E2B_WEBHOOKS=