# Server Environment (development | staging | production | test)
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Logging Configuration (console | json)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://verischolar:verischolar@localhost:5432/verischolar

# LLM Inference Providers (docker-model-runner | openai | gemini | ollama)
LLM_PROVIDER=openai

# Docker Model Runner Configuration (Local Inference via port 12434)
# When running on host: http://localhost:12434/engines/llama.cpp/v1
# When running inside docker container: http://host.docker.internal:12434/engines/llama.cpp/v1
DMR_BASE_URL=http://localhost:12434/engines/llama.cpp/v1
DMR_MODEL=ai/smollm2

# Cloud LLM API Keys (Optional if using Docker Model Runner)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
